{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "format": "uri", "description": "URL to user's profile picture" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created" }
      },
      "required": ["uid", "email"]
    },
    "connection": {
      "title": "Connection",
      "description": "A saved infrastructure bridge connection between a host and a database",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner" },
        "name": { "type": "string", "description": "Custom name for the connection" },
        "host": {
          "type": "object",
          "properties": {
            "platform": { "type": "string" },
            "name": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "platform": { "type": "string" },
            "projectRef": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "lastSynced": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "error"] }
      },
      "required": ["userId", "host", "database"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Private user profile data"
    },
    "/users/{userId}/connections/{connectionId}": {
      "schema": "connection",
      "description": "User's individual infrastructure bridge connections"
    }
  }
}
